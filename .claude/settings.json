{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edit.sh", "timeout": 60 }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./dev.sh)",
      "Bash(node web/scripts/shot.mjs:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(npx tsc -b)",
      "Bash(npm run build)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.dev)"
    ]
  }
}
