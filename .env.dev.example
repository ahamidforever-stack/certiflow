# Local development settings, loaded by ./dev.sh.
# Copy to .env.dev (git-ignored, never commit it) and fill in:  cp .env.dev.example .env.dev
# (.env / .env.example are for the Docker production stack.)

# mock = offline fake translations (free) | anthropic = real Claude API (costs money)
CERTIFLOW_LLM=mock
CERTIFLOW_ANTHROPIC_API_KEY=
# samples = placeholder assets | assets/shoreline/library.json = real office assets (after unzipping them)
CERTIFLOW_LIBRARY=samples/assets/library.json
