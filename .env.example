# Copy to .env on the server (never commit .env)
POSTGRES_PASSWORD=change-me-long-random
CERTIFLOW_SECRET_KEY=change-me-64-hex-chars
CERTIFLOW_ANTHROPIC_API_KEY=
CERTIFLOW_SECURE_COOKIES=1
CERTIFLOW_LLM=anthropic
# Backups: a long passphrase (keep a copy in a safe place, without it backups cannot be restored)
CERTIFLOW_BACKUP_KEY=
